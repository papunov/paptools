{
  "mcpServers": {
    "mongodb-atlas": {
      "command": "npx",
      "args": [
        "-y",
        "mongodb-mcp-server@latest"
      ],
      "env": {
        "MDB_MCP_CONNECTION_STRING": "mongodb+srv://<user>:<password>@<cluster>.mongodb.net/PersonalManager?retryWrites=true&w=majority"
      }
    }
  }
}
